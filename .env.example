# AXON Challenge Prototype environment
# Gemini is optional. Without it, deterministic evaluation remains available
# and the UI labels the advisory as unavailable.
GEMINI_API_KEY=
GEMINI_ADVISORY_MODEL=gemini-3.5-flash
GEMINI_ADVISORY_TIMEOUT_MS=8000

# Optional Bearer protection for API callers. Leave empty for the browser demo;
# the dashboard does not send a browser API key.
AXON_API_KEY=
