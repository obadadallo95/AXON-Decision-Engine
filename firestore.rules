rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Pillar 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Common primitive helpers (Pillar 3)
    function isSignedIn() {
      return request.auth != null;
    }

    // For the public simulation demo, we allow all users to act as verified users
    function isVerifiedUser() {
      return true; 
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // For the public simulation demo, we allow all users to act as authorized personnel
    function isAuthorizedPersonnel() {
      return true; 
    }

    // Validation Blueprint for Audit Logs (Pillar 2)
    function isValidAuditLog(data) {
      return data.keys().hasAll([
        'prompt', 'category', 'decision', 'riskScore', 'reasonEn', 'reasonAr',
        'mitigationEn', 'mitigationAr', 'groundingEn', 'groundingAr', 'timestamp',
        'citations', 'matchedPolicyCodes', 'requestClassificationEn', 'requestClassificationAr'
      ]) &&
      data.keys().size() >= 15 &&
      data.prompt is string && data.prompt.size() <= 5000 &&
      data.category is string && data.category.size() <= 100 &&
      data.decision is string && data.decision in ['ALLOW', 'DENY', 'NEEDS_CLARIFICATION', 'ESCALATE_TO_HUMAN'] &&
      data.riskScore is int && data.riskScore >= 0 && data.riskScore <= 100 &&
      data.reasonEn is string && data.reasonEn.size() <= 10000 &&
      data.reasonAr is string && data.reasonAr.size() <= 10000 &&
      data.mitigationEn is string && data.mitigationEn.size() <= 10000 &&
      data.mitigationAr is string && data.mitigationAr.size() <= 10000 &&
      data.groundingEn is string && data.groundingEn.size() <= 10000 &&
      data.groundingAr is string && data.groundingAr.size() <= 10000 &&
      data.citations is list &&
      data.matchedPolicyCodes is list &&
      data.requestClassificationEn is string &&
      data.requestClassificationAr is string;
    }

    // Validation Blueprint for Escalated Items (Pillar 2)
    function isValidEscalatedItem(data) {
      return data.keys().hasAll([
        'prompt', 'category', 'riskScore', 'reasonEn', 'reasonAr', 'status', 'timestamp'
      ]) &&
      data.keys().size() >= 7 &&
      data.prompt is string && data.prompt.size() <= 5000 &&
      data.category is string && data.category.size() <= 100 &&
      data.riskScore is int && data.riskScore >= 0 && data.riskScore <= 100 &&
      data.reasonEn is string && data.reasonEn.size() <= 10000 &&
      data.reasonAr is string && data.reasonAr.size() <= 10000 &&
      data.status is string && data.status in ['pending', 'approved', 'rejected', 'resolved'];
    }

    // Validation Blueprint for Policies (Pillar 2)
    function isValidSecurityPolicy(data) {
      return data.keys().hasAll(['code', 'descriptionEn', 'descriptionAr']) &&
      data.keys().size() >= 3 && data.keys().size() <= 6 &&
      data.code is string && data.code.size() <= 20 && data.code.matches('^[A-Z0-9]+$') &&
      data.descriptionEn is string && data.descriptionEn.size() <= 1000 &&
      data.descriptionAr is string && data.descriptionAr.size() <= 1000 &&
      (!data.keys().contains('sourceType') || data.sourceType is string) &&
      (!data.keys().contains('originalFilename') || data.originalFilename is string) &&
      (!data.keys().contains('importedAt') || data.importedAt is string);
    }

    // 1. Audit Logs Collection Rules
    match /audit_logs/{logId} {
      // Secure List Queries (Pillar 8)
      allow list: if isVerifiedUser();
      allow get: if isVerifiedUser();
      
      // Logs are immutable (Pillar 4 / Pillar 12)
      allow create: if isVerifiedUser() && isValidId(logId) && isValidAuditLog(incoming());
      
      // No updates or deletions to audit logs are ever allowed (zero-trust immutability)
      allow update, delete: if false;
    }

    // 2. Escalated Queue Collection Rules
    match /escalated_queue/{itemId} {
      allow list, get: if isVerifiedUser();
      
      // Operators can create a pending escalation item
      allow create: if isVerifiedUser() && isValidId(itemId) && isValidEscalatedItem(incoming()) && incoming().status == 'pending';
      
      // Reviewers can update pending escalation status with review comments (Pillar 4 / 6)
      allow update: if isAuthorizedPersonnel() && 
        isValidId(itemId) && 
        existing().status == 'pending' &&
        incoming().status in ['approved', 'rejected', 'resolved'] &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewerComment', 'reviewedAt']);

      allow delete: if false; // Escalation records cannot be deleted
    }

    // 3. Security Policies Collection Rules
    match /policies/{policyCode} {
      allow list, get: if isVerifiedUser();
      
      // Policies can only be added/edited by authorized corporate governance profiles
      allow create, update: if isAuthorizedPersonnel() && isValidId(policyCode) && isValidSecurityPolicy(incoming()) && incoming().code == policyCode;
      allow delete: if isAuthorizedPersonnel() && isValidId(policyCode);
    }
  }
}
